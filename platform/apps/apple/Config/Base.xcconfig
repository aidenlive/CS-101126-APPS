// Shared build settings for the Cardsite Apple app.
// `//` starts a comment in xcconfig, so URLs use the `$()` break: https:/$()/host

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// OWNER DECISION (docs/launch/native-apple.md, N1): the bundle ID is
// permanent once the app is created in App Store Connect.
CARDSITE_BUNDLE_ID = com.cardsite.app

// Public address host (docs/brand/Cardsite-Overview.md → Domains).
CARDSITE_PUBLIC_HOST = card.site

// Web app and marketing site; legal pages and contact live here.
CARDSITE_WEB_URL = https:/$()/cardsite.com

// Shared session between the app, widgets and share extension (SharedSession
// in CardsiteKit). AppIdentifierPrefix is the team ID plus a dot, set by
// signing. Empty values turn sharing off.
CARDSITE_APP_GROUP = group.$(CARDSITE_BUNDLE_ID)
CARDSITE_KEYCHAIN_GROUP = $(AppIdentifierPrefix)$(CARDSITE_BUNDLE_ID).shared
// "" signs with the App Group and keychain group; "-Local" signs without
// them (see Signing.example.xcconfig).
CARDSITE_ENTITLEMENTS_SUFFIX =

// Per-developer: team, and optionally a local bundle ID or local signing.
#include? "Signing.xcconfig"
