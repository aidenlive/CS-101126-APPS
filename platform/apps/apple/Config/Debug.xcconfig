#include "Base.xcconfig"

// Local stack from `make -C platform up` (API on :8080).
// The simulator reaches the Mac's localhost directly; a device needs the
// Mac's LAN address here instead.
CARDSITE_API_BASE_URL = http:/$()/localhost:8080

// Per-machine override (git-ignored), e.g. for a physical iPhone:
//   CARDSITE_API_BASE_URL = http:/$()/Your-Mac-Name.local:8080
// See Config/Local.example.xcconfig.
#include? "Local.xcconfig"

SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
SWIFT_OPTIMIZATION_LEVEL = -Onone
ONLY_ACTIVE_ARCH = YES
