<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iPhone, iPad and Apple Vision Pro. The session is shared with the
	     widgets and the share extension (SharedSession in CardsiteKit):
	     its context in the App Group, the token in the shared Keychain
	     group. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(CARDSITE_APP_GROUP)</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(CARDSITE_KEYCHAIN_GROUP)</string>
	</array>
</dict>
</plist>
